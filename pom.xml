    <profiles>
        <profile>
            <id>validator</id>
            <modules>
                <module>validator-first-dependency</module>
                <module>validator</module>
            </modules>
        </profile>
        <!--
            Activated by -Ppublish, NOT -Prelease, and the name is load-bearing. The parent pom
            defines a profile called `release`, so `-Prelease` activates that one too; both then
            declare a maven-source-plugin execution with the id `attach-sources`, which Maven merges
            into a single execution with two goals and the build fails with "Presumably you have
            configured maven-source-plugin to execute twice in your build". Calling this `publish`
            keeps the parent's `release` dormant. See the comment on maven-source-plugin above.

            GPG signing is kept out of the default build so that an ordinary `mvn install` on a
            developer machine does not require a private key.

            Requires a GPG signing key reachable by the plugin, and a Maven `server` entry with
            the id `central` carrying the Central Portal user token in ~/.m2/settings.xml. See
            RELEASE.md for the full procedure, including the pinentry settings gpg-agent needs
            when the key has a passphrase.
        -->
        <profile>
            <id>publish</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                                Auto-publish drops the bundle straight into Central. Set to true
                                only if that is wanted; leaving it false means the bundle is
                                created and then released explicitly from the Portal UI, which is
                                the safer default for a first upload.
                            -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>


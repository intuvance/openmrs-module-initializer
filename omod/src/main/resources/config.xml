<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.6">

	<!-- Base Module Properties -->
	<id>${project.parent.artifactId}</id>
	<name>${project.parent.name}</name>
	<version>${project.parent.version}</version>
	<!--
		Hard-coded, and deliberately NOT ${project.parent.groupId}.${project.parent.artifactId}.

		OpenMRS resolves a module's <require_module> dependencies by matching the required name
		against Module.getPackageName(), which is this element, and there is no fallback to the
		module id. So this value is a public API that other modules hard-code.

		The module's Java classes have never moved: they are in org.openmrs.module.initializer,
		as <activator> below still shows. Deriving this from the Maven coordinates changed it to
		io.github.intuvance.initializer when the fork was published under a new groupId, and every
		module declaring a dependency on org.openmrs.module.initializer then failed to start.
		patientdocuments 1.1.0 requires "org.openmrs.module.initializer" version 2.9.0, so it was
		rejected at startup with "cannot be started because it requires the following module(s):
		initializer 2.9.0" while the Initializer itself was running perfectly well.

		Keep this equal to the package the classes are compiled into. The Maven groupId may be
		whatever is needed to publish the fork; it must not leak into here.
	-->
	<package>org.openmrs.module.initializer</package>
	<author>${project.parent.organization.name}</author>
	<description>${project.parent.description}</description>

	<activator>org.openmrs.module.initializer.InitializerActivator</activator>

	<require_version>${openmrsPlatformVersion}</require_version>

	<conditionalResources>
		<conditionalResource>
			<path>/lib/initializer-api-2.4-${project.version}.jar</path>
			<openmrsVersion>2.4.* - 9.*</openmrsVersion>
		</conditionalResource>
		<conditionalResource>
			<path>/lib/initializer-api-2.5-${project.version}.jar</path>
			<openmrsVersion>2.5.* - 9.*</openmrsVersion>
		</conditionalResource>
		<conditionalResource>
			<path>/lib/initializer-api-2.7-${project.version}.jar</path>
			<openmrsVersion>2.7.* - 9.*</openmrsVersion>
		</conditionalResource>
		<conditionalResource>
			<path>/lib/initializer-api-2.8-${project.version}.jar</path>
			<openmrsVersion>2.8.* - 9.*</openmrsVersion>
		</conditionalResource>
	</conditionalResources>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
		<aware_of_module version="${htmlformentryVersion}">
			org.openmrs.module.htmlformentry
		</aware_of_module>
		<aware_of_module version="${idgenVersion}">
			org.openmrs.module.idgen
		</aware_of_module>
		<aware_of_module version="${metadatasharingVersion}">
			org.openmrs.module.metadatasharing
		</aware_of_module>
		<aware_of_module version="${metadatamappingVersion}">
			org.openmrs.module.metadatamapping
		</aware_of_module>
		<aware_of_module version="${appointmentsVersion}">
			org.bahmni.module.appointments
		</aware_of_module>
		<aware_of_module version="${datafilterVersion}">
			org.openmrs.module.datafilter
		</aware_of_module>
		<aware_of_module version="${bahmniIeAppsVersion}">
			org.bahmni.module.bahmni.ie.apps
		</aware_of_module>
		<aware_of_module version="${openconceptlabVersion}">
			org.openmrs.module.openconceptlab
		</aware_of_module>
		<aware_of_module version="${bahmniCoreVersion}">
			org.bahmni.module.bahmnicore
		</aware_of_module>
		<aware_of_module version="${cohortModuleVersion}">
			org.openmrs.module.cohort
		</aware_of_module>
		<aware_of_module version="${emrapiModuleVersion}">
			org.openmrs.module.emrapi
		</aware_of_module>
		<aware_of_module version="${fhir2Version}">
			org.openmrs.module.fhir2
		</aware_of_module>
		<aware_of_module version="${queueVersion}">
			org.openmrs.module.queue
		</aware_of_module>
		<aware_of_module version="${addresshierarchyVersion}">
			org.openmrs.module.addresshierarchy
		</aware_of_module>
		<aware_of_module version="${billingVersion}">
			org.openmrs.module.billing
		</aware_of_module>
		<aware_of_module version="${patientflagsVersion}">
			org.openmrs.module.patientflags
		</aware_of_module>
		<aware_of_module version="${tasksVersion}">
			org.openmrs.module.tasks
		</aware_of_module>
	</aware_of_modules>

	<!-- Internationalization -->
	<!-- All message codes should start with @MODULE_ID@.* -->
	<messages>
		<lang>en</lang>
		<file>messages.properties</file>
	</messages>
	<!-- /Internationalization -->

</module>
